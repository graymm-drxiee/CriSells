# Copy to .env and fill in. .env is gitignored — never commit real credentials.
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net
MONGODB_DB=crisells
PORT=4000

# Admin account. It is seeded into the users collection on boot and signs in
# through the normal /login page. Staff accounts must also pass a 2FA code.
ADMIN_EMAIL=admin@crisells.com
# Required: sets (and rotates) the admin password on boot.
ADMIN_PASSWORD=change-me

# Recovery override: forces a known authenticator secret and marks 2FA enrolled.
# Leave empty to enroll from the login screen on first run.
TOTP_SECRET=
TOTP_ISSUER=CriSells
# Fallback for ADMIN_EMAIL when that is unset.
TOTP_ACCOUNT=admin@crisells.com

# Set to "production" so the session cookies are marked Secure.
NODE_ENV=development

# Number of reverse proxies in front of the app. Only read when NODE_ENV=production.
# Required behind Render/Vercel/Nginx, otherwise per-IP rate limiting sees the proxy IP.
TRUST_PROXY=1

# Atlas: restrict Network Access to the server's IPs (never 0.0.0.0/0 in production).
# Password reset links are only logged to the console in development; wire an email
# provider before production or resets will not reach customers.

# Public site URL used in password reset links. Defaults to the request origin.
APP_URL=http://localhost:5173
